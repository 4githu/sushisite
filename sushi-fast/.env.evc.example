EVC_EVALUATION_PROVIDER=gpt
OPENAI_EVC_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
# Needed only for Jev live evaluation. Final reports still require OpenAI.
TYPESAFE_API_KEY=
TYPESAFE_JEV_MODEL=jev-latest
DEEPGRAM_API_KEY=
