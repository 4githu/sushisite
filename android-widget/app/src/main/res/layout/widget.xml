<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:id="@+id/title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="다음 일정" android:textColor="#253244" android:textSize="18sp" android:textStyle="bold"/><TextView android:id="@+id/previous" android:layout_width="36dp" android:layout_height="40dp" android:gravity="center" android:text="‹" android:textSize="24sp" android:textColor="#253244" android:contentDescription="이전 기간"/><TextView android:id="@+id/today" android:layout_width="36dp" android:layout_height="40dp" android:gravity="center" android:text="오늘" android:textSize="12sp" android:textColor="#253244" android:contentDescription="오늘로 이동"/><TextView android:id="@+id/next" android:layout_width="36dp" android:layout_height="40dp" android:gravity="center" android:text="›" android:textSize="24sp" android:textColor="#253244" android:contentDescription="다음 기간"/><TextView android:id="@+id/refresh" android:layout_width="36dp" android:layout_height="40dp" android:gravity="center" android:text="↻" android:textSize="24sp" android:textColor="#245AC7" android:contentDescription="일정 새로고침"/></LinearLayout>
 <ProgressBar android:id="@+id/loading" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center_horizontal" android:visibility="gone" android:contentDescription="일정 불러오는 중"/>
 <LinearLayout android:id="@+id/events" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"/>
 <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="온도 위젯 앱에서 계정을 연결하세요" android:textColor="#758096" android:textSize="11sp"/>
</LinearLayout>
