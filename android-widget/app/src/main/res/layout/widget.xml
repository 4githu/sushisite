<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><TextView android:id="@+id/title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="다음 일정" android:maxLines="1" android:ellipsize="end" android:textColor="#242529" android:textSize="18sp" android:textStyle="bold"/><TextClock android:id="@+id/now_clock" android:layout_width="wrap_content" android:layout_height="40dp" android:gravity="center" android:format24Hour="HH:mm" android:format12Hour="HH:mm" android:timeZone="Asia/Seoul" android:textColor="#C4412C" android:textSize="13sp" android:paddingEnd="6dp" android:visibility="gone"/><TextView android:id="@+id/previous" android:layout_width="36dp" android:layout_height="40dp" android:gravity="center" android:text="‹" android:textSize="24sp" android:textColor="#242529" android:contentDescription="이전 기간"/><TextView android:id="@+id/today" android:layout_width="36dp" android:layout_height="40dp" android:gravity="center" android:text="오늘" android:textSize="12sp" android:textColor="#242529" android:contentDescription="오늘로 이동"/><TextView android:id="@+id/next" android:layout_width="36dp" android:layout_height="40dp" android:gravity="center" android:text="›" android:textSize="24sp" android:textColor="#242529" android:contentDescription="다음 기간"/><TextView android:id="@+id/add" android:contentDescription="빠른 기록" android:text="+" android:textColor="#C4412C" android:layout_width="36dp" android:layout_height="40dp" android:gravity="center" android:textSize="24sp"/><TextView android:id="@+id/refresh" android:layout_width="36dp" android:layout_height="40dp" android:gravity="center" android:text="↻" android:textSize="24sp" android:textColor="#C4412C" android:contentDescription="일정 새로고침"/></LinearLayout>
 <ProgressBar android:id="@+id/loading" android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center_horizontal" android:visibility="gone" android:contentDescription="일정 불러오는 중"/>
 <LinearLayout android:id="@+id/events" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"/>
 <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="NETAQ 위젯 앱에서 계정을 연결하세요" android:textColor="#696B73" android:textSize="11sp"/>
</LinearLayout>
